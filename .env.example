# SiNaPsE TeslaMate all-in-one HTTPS stack.
# Portainer: add these SAME keys under Stack > Environment variables.
# Docker Compose CLI: copy this file to .env, replace every secret/example value, then run:
# docker compose -f compose.yml up -d --build --wait
#
# IMPORTANT: keep a secure backup of all values used in production.
# ENCRYPTION_KEY must NEVER be regenerated for an existing TeslaMate database.

# TeslaMate / PostgreSQL
ENCRYPTION_KEY=replace-with-a-long-random-key
DATABASE_USER=teslamate
DATABASE_PASS=replace-with-a-strong-database-password
DATABASE_NAME=teslamate
TM_TZ=Europe/Rome

# Single public FQDN used by both services:
# TeslaMate -> https://FQDN_TM/
# Grafana   -> https://FQDN_TM/grafana
# DNS for this FQDN must point to the Docker/Portainer host.
FQDN_TM=teslamate.example.com
LETSENCRYPT_EMAIL=you@example.com

# HTTP Basic Auth protecting the TeslaMate web UI.
# Do NOT use Tesla account credentials here.
BASIC_AUTH_USER=teslamate
BASIC_AUTH_PASSWORD=replace-with-a-strong-basic-auth-password

# Grafana login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

# MQTT is intentionally bound to localhost only.
MQTT_PORT=1883
