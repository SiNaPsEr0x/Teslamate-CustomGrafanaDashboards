# Replace all three values before the first startup. Never commit .env.
ENCRYPTION_KEY=replace-with-a-long-random-key
DATABASE_PASS=replace-with-a-strong-database-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Local access by default; set a LAN address only when needed.
BIND_ADDRESS=127.0.0.1
TESLAMATE_PORT=4000
GRAFANA_PORT=3000
