# SiNaPsE TeslaMate all-in-one HTTPS stack.
# Copy to .env, replace every secret/example value, then run:
# docker compose -f compose.yml up -d --build --wait

# TeslaMate / PostgreSQL
ENCRYPTION_KEY=replace-with-a-long-random-key
DATABASE_USER=teslamate
DATABASE_PASS=replace-with-a-strong-database-password
DATABASE_NAME=teslamate
TM_TZ=Europe/Rome

# Public HTTPS endpoint. DNS for this FQDN must point to the Docker host.
FQDN_TM=teslamate.example.com
LETSENCRYPT_EMAIL=you@example.com

# HTTP Basic Auth protecting the TeslaMate web UI at https://FQDN_TM/
BASIC_AUTH_USER=teslamate
BASIC_AUTH_PASSWORD=replace-with-a-strong-basic-auth-password

# Grafana login at https://FQDN_TM/grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

# MQTT is intentionally bound to localhost only.
MQTT_PORT=1883
